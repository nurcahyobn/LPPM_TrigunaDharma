# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE — LPPM TRIGUNA DHARMA (COOLIFY PRODUCTION)
# ==============================================================================
# PERINGATAN KEAMANAN:
# 1. JANGAN PERNAH meng-commit file .env yang berisi credential asli ke Git!
# 2. Masukkan variabel-variabel ini langsung ke menu Environment Variables di Coolify.
# 3. Nilai VITE_* diinjeksi saat BUILD TIME frontend dan bersifat PUBLIK di bundle browser.
# ==============================================================================

# ─── FRONTEND BUILD ARGUMENTS (VITE) ──────────────────────────────────────────
# Base URL API backend yang diakses oleh browser pengguna di client-side.
# Harus menyertakan skema HTTPS dan path /api/v1.
VITE_API_URL=https://api.lppm.trigunadharma.ac.id/api/v1

# ─── BACKEND APPLICATION RUNTIME ──────────────────────────────────────────────
PORT=3000
NODE_ENV=production
APP_NAME="LPPM Universitas Triguna Dharma"
FRONTEND_URL=https://lppm.trigunadharma.ac.id
CORS_ORIGIN=https://lppm.trigunadharma.ac.id

# Wajib 'true' jika aplikasi di balik reverse proxy Coolify (Traefik/Caddy)
# agar rate limiting dan logging mencatat IP asli pengguna dari X-Forwarded-For.
TRUST_PROXY=true

# ─── JWT AUTHENTICATION SECRETS ──────────────────────────────────────────────
# Generate rahasia acak 64 karakter (contoh: openssl rand -base64 48)
JWT_ACCESS_SECRET=replace_with_strong_random_secret_min_64_chars_for_access
JWT_REFRESH_SECRET=replace_with_strong_random_secret_min_64_chars_for_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
# 500 request per 15 menit per IP (900000 ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# ─── DATABASE (MARIADB) CREDENTIALS ───────────────────────────────────────────
DB_NAME=lppm_db
DB_USER=lppm_user
# Password kuat untuk aplikasi user (gunakan alphanumeric + simbol aman seperti _ - .)
DB_PASSWORD=replace_with_strong_database_password
# Password root MariaDB untuk keperluan maintenance / restore
DB_ROOT_PASSWORD=replace_with_strong_root_password

# Format DSN internal (opsional jika menggunakan konstruksi otomatis dari compose.yaml):
# DATABASE_URL=mysql://lppm_user:replace_with_strong_database_password@db:3306/lppm_db?charset=utf8mb4&parseTime=True&loc=UTC

# ─── SMTP / EMAIL SETTINGS (OPSIONAL) ─────────────────────────────────────────
# Digunakan untuk fitur lupa password dan verifikasi email.
# Jika tidak diisi, tautan reset password/verifikasi akan dicatat di log backend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=lppm@trigunadharma.ac.id
SMTP_PASS=replace_with_app_password

# ─── AUTOMATED DATABASE BACKUP ────────────────────────────────────────────────
# Backend Go memiliki modul pencadangan otomatis internal (.sql.gz ke /app/backups).
BACKUP_OTOMATIS=true
BACKUP_DIR=/app/backups
BACKUP_HARI=1
BACKUP_JAM=2
BACKUP_ZONA=Asia/Jakarta
